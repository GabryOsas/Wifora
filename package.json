{
  "name": "wifora",
  "version": "1.0.0",
  "description": "Ultra-low latency Wi-Fi audio streaming from PC to any mobile device (iOS, iPadOS, Android) with zero app installs.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GabryOsas/Wifora.git"
  },
  "keywords": [
    "audio-streaming",
    "webrtc",
    "opus",
    "wifi-audio",
    "zero-app",
    "lan-streaming",
    "dsp",
    "low-latency",
    "audio-sharing"
  ],
  "author": "GabryOsas",
  "license": "MIT",
  "funding": {
    "type": "buy-me-a-coffee",
    "url": "https://buymeacoffee.com/gabryosas"
  },
  "scripts": {
    "start": "node server.mjs",
    "menu": "node cli-menu.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node benchmarks/run-benchmark.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
